# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Public backend origin for production deployments.
# Leave empty for local development; Vite proxies /api to localhost:4000.
VITE_API_BASE_URL=

# DEPLOYMENT MODE:
# 'site'  -> Builds only public event site (/register, /pay149, landing page; excludes /admin)
# 'admin' -> Builds only the standalone Admin portal at root / (zero Community Day mentions)
# Leave unset or empty for shared development mode
VITE_APP_MODE=

# FIREBASE CONFIGURATION (Firestore Cloud Database):
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# OPTION A: DIRECT GMAIL SENDER (Zero DNS, Zero Domain Setup - 100% Free & Direct to Student Inbox)
# 1. Go to Google Account -> Security -> Enable 2-Step Verification
# 2. Go to https://myaccount.google.com/apppasswords -> Create App Password named "TicketPass"
# 3. Paste your Gmail and 16-letter App Password below:
VITE_GMAIL_USER=yourname@gmail.com
VITE_GMAIL_APP_PASSWORD=your_16_letter_app_password

# OPTION B: RESEND EMAIL CONFIGURATION (Automatic Ticket Emails on Approval):
# Get API key from https://resend.com/api-keys
VITE_RESEND_API_KEY=re_your_api_key_here
# Optional: your verified domain e.g. tickets@awscommunityday.in (defaults to onboarding@resend.dev)
VITE_RESEND_FROM_EMAIL=onboarding@resend.dev

