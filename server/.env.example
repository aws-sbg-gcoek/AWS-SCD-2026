# Copy to server/.env and fill in real values. Never commit server/.env.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# PostgreSQL connection. Local example; production providers give you a connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aws_scd
# For providers requiring TLS, set DATABASE_SSL=true. Follow your provider's certificate guidance.
DATABASE_SSL=false
# Set false only if your provider requires it and you understand the certificate trade-off.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Razorpay TEST keys for development. Keep the secret server-side only.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Important: set these to the organizer-approved capacity before allowing sales.
# 0 disables sales for that tier (safe default).
TICKET_CAPACITY_EARLY_BIRD=0
TICKET_CAPACITY_REGULAR=0

# Booking reservation expires after this many minutes if unpaid.
BOOKING_HOLD_MINUTES=15

# Optional transactional ticket confirmation email (requires a verified sender in Resend)
RESEND_API_KEY=
TICKET_FROM_EMAIL=
